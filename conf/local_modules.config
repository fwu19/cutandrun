                    mode: "${params.publish_dir_mode}",
                    pattern: 'ERROR_MESSAGE*',
                    optional: true,
                    enabled: true
                ]
            ]
        }
    }
}


if(params.run_local_report) {
    process{
        withName: '.*:GENERATE_REPORT' {
            ext.suffix = ""
            publishDir = [
                [
                    path: { "saved_data/individual_igg/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.{rds,Rmd,rmd}',
                    enabled: true
                ],
                [
                    path: { "${params.outdir}/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.html',
                    enabled: true
                ]
            ]
        }

        withName: '.*:GENERATE_REPORT_COMB_IGG' {
            ext.suffix = ".combined_IgG"
            publishDir = [
                [
                    path: { "saved_data/combined_igg/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.{rds,Rmd,rmd}',
                    enabled: true
                ],
                [
                    path: { "${params.outdir}/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.html',
                    enabled: true
                ]
            ]
        }

        withName: '.*:GENERATE_REPORT_PROCESS_CONTROLS' {
            publishDir = [
                [
                    path: { "saved_data/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.{rds,Rmd,rmd}',
                    enabled: true
                ],
                [
                    path: { "${params.outdir}/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.html',
                    enabled: true
                ]
            ]
        }
    }

}
