                enabled: true
            ]
        }

        withName: '.*:DIFFERENTIAL_PEAKS' {
            publishDir = [
                [
                    path: { "${params.outdir}/04_peak_calling/5_differential_consensus_peaks/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*_peaks',
                    optional: true,
                    enabled: true
                ],
                [
                    path: { "${params.outdir}/04_peak_calling/5_differential_consensus_peaks/" },
                    mode: "${params.publish_dir_mode}",
