                mode: "${params.publish_dir_mode}",
                pattern: '*.csv',
                enabled: false
            ]
        }

    }

    // with combined IgG
    process{
        withName: '.*:QC_PEAKS_COMB_IGG:READS_IN_PEAK' {
            publishDir = [
                path: { "${params.outdir}/04_reporting/qc/reads_in_peak/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.reads_in_peak.csv',
                enabled: false
            ]
        }

        withName: '.*:QC_PEAKS_COMB_IGG:ORIGINAL_PEAKS' {
            publishDir = [
                path: { "${params.outdir}/04_reporting/qc/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.csv',
                enabled: false
            ]
        }

        withName: '.*:QC_PEAKS_COMB_IGG:ORIGINAL_PEAK_WIDTHS' {
            publishDir = [
                path: { "${params.outdir}/04_reporting/qc/" },
                mode: "${params.publish_dir_mode}",
