/*
From cutandrun/nextflow.config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/cutandrun Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

/*
*** Flow switching and result output ***
There are three keywords for controling program flow and results output:
    - save_* - Specifies whether to save information to output
    - skip_* - Specifies whether to skip a process of group of processes
    - only_* - Only run the pipeline up to this point
*/

// overwrite nf-core configs
params {
    // References
    genome                     = 'default'
    spikein_genome             = "K12-MG1655" // a common E. coli strain, use "R64-1-1" for yeast (S. cerevisiae) spike-in, BDGP6 for the fruit fly (D. melanogaster)
    gene_bed                   = null
    blacklist                  = null
    save_reference             = false
    only_genome                = false

    // Input and merging
    save_merged_fastq          = false
    only_input                 = false

    // Pre-align QC
    skip_fastqc                = false
    only_preqc                 = false

    // Trimming
    clip_r1                    = 0
    clip_r2                    = 0
    three_prime_clip_r1        = 0
    three_prime_clip_r2        = 0
    trim_nextseq               = 20
    save_trimmed               = false
    skip_trimming              = false

    // Alignment
    aligner                    = "bowtie2"
    save_spikein_aligned       = false
    save_unaligned             = false
    only_alignment             = false
    save_align_intermed        = false
    end_to_end                 = false

    // Filtering
    minimum_alignment_q_score  = 0
    remove_mitochondrial_reads = false
    mito_name                  = null

    // Deduplication
    skip_removeduplicates      = false
    dedup_target_reads         = true
    only_filtering             = false
    remove_linear_duplicates   = false

    // Read Normalisation
    normalisation_mode         = "None"
    normalisation_binsize      = 50
    normalisation_c            = 10000
    igg_scale_factor           = 1

    // Peak Caller default param
    peakcaller                 = 'seacr,macs2'

    // Peak Calling
    use_control                = true
    only_peak_calling          = false
    extend_fragments           = true
    seacr_norm                 = 'norm'
    seacr_stringent            = 'stringent'
    seacr_peak_threshold       = 0.01
    macs2_pvalue               = null
    macs2_qvalue               = 0.05
    macs_gsize                 = 2700000000.0
    macs2_narrow_peak          = true
    macs2_broad_cutoff         = 0.1

    // Consensus Peaks
    consensus_peak_mode        = 'group'
    replicate_threshold        = 1.0

    // Reporting and Visualisation
    skip_reporting             = true
    skip_igv                   = true
    skip_heatmaps              = true
    skip_dt_qc                 = true
    skip_peak_qc               = true
    skip_preseq                = true
    skip_multiqc               = false
    dump_scale_factors         = false
    igv_show_gene_names        = true
    igv_sort_by_groups         = true
    min_frip_overlap           = 0.2
    min_peak_overlap           = 0.2

    // Deeptools options
    dt_heatmap_gene_bodylen    = 5000
    dt_heatmap_gene_beforelen  = 3000
    dt_heatmap_gene_afterlen   = 3000
    dt_heatmap_peak_beforelen  = 3000
    dt_heatmap_peak_afterlen   = 3000
    dt_qc_bam_binsize          = 500
    dt_qc_corr_method          = "pearson"
    fragment_size              = 100 // PARAM NOT USED
    dt_calc_all_matrix         = false

    // Boilerplate options
    publish_dir_mode                  = "copy"
    multiqc_config                    = null
    multiqc_title                     = null
    multiqc_logo                      = null
    multiqc_methods_description       = null
    email                             = null
    email_on_fail                     = null
    max_multiqc_email_size            = "25.MB"
    plaintext_email                   = false
    monochrome_logs                   = false
    hook_url                          = null
    help                              = false
    version                           = false
    igenomes_ignore                   = false
    singularity_pull_docker_container = false
}

// Setting for local pipeline
params{
    workflow                          = "cutandrun"
    outdir                            = "./Analysis"
    min_replicates                    = 2
    input                             = "$projectDir/assets/dummy_file.csv"
    input_dir                         = "$projectDir/assets/dummy_dir/"
    metadata                          = "$projectDir/assets/dummy_file.csv"
    comparison                        = "$projectDir/assets/dummy_file.csv"

    run_combine_igg                   = false
    igg_group                         = 'group' // [ 'group', 'all', column_name_in_samplesheet ]

    igg_dir                           = "$projectDir/assets/dummy_dir/"
    use_igg                           = true

    skip_individual_igg               = false

}


// Capture exit codes from upstream processes when piping
process.shell = ["/bin/bash", "-euo", "pipefail"]

def trace_timestamp = new java.util.Date().format( "yyyy-MM-dd_HH-mm-ss")
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled = false
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

