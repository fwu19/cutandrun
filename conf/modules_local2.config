
/*
modified from cutandrun/conf/modules.config
========================================================================================
    Config file for defining DSL2 per module options and publishing paths
========================================================================================
    Available keys to override module options:
        ext.args            = Additional arguments appended to command in module.
        ext.args2           = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3           = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix          = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

/*
========================================================================================
    GENERAL
========================================================================================
*/

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: "${params.publish_dir_mode}",
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: "${params.publish_dir_mode}",
            pattern: '*_versions.yml'
        ]
    }

    withName: WRITE_CSV {
        publishDir = [
            path: { "${params.outdir}/csv/" },
            mode: "${params.publish_dir_mode}",
            pattern: '*.csv',
            enabled: true
        ]
    }

}

/*
========================================================================================
    INPUT
========================================================================================
*/

if(params.run_input_check) {
    process {
        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:INPUT_CHECK:SAMPLESHEET_CHECK' {
            publishDir = [
                path: { "${params.outdir}/pipeline_info/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.csv"
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:INPUT_CHECK:GROUP_IGG' {
            publishDir = [
                path: { "${params.outdir}/pipeline_info/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.csv"
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:GET_FASTQ_PATHS' {
            ext.args   = " r1_pattern='_S[0-9]+(_L[0-9]+)?_R1_' r2_pattern='_S[0-9]+(_L[0-9]+)?_R2_' "
            publishDir = [
                enabled: false
            ]
        }

    }
}

/*
========================================================================================
    GENOME PREPARATION
========================================================================================
*/


if(params.run_genome_prep) {
    process {
        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:PREPARE_GENOME:UNTAR_.*' {
            ext.args2 = '--no-same-owner'
        }

        withName: '.*PREPARE_GENOME:GUNZIP_.*' {
            publishDir = [
                enabled: false
            ]
        }

        withName: '.*PREPARE_GENOME:TABIX_BGZIPTABIX' {
            publishDir = [
                path: { "${params.outdir}/reference/${params.target_genome}/annotation" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }

        withName: '.*CHROMSIZES' {
            publishDir = [
                path: { "${params.outdir}/reference/${params.target_genome}/genome" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }

        withName: 'UNTAR_INDEX_.*|TARGET|SPIKEIN' {
            publishDir = [
                path: { "${params.outdir}/${params.target_genome}/reference" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }

        withName: 'BOWTIE2_BUILD_.*|TARGET|SPIKEIN' {
            publishDir = [
                path: { "${params.outdir}/reference/${params.target_genome}/" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_reference
            ]
        }

        withName: '.*PREPARE_GENOME:SAMTOOLS_FAIDX' {
            publishDir = [
                path: { "${params.outdir}/reference/${params.target_genome}/genome" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:PREPARE_GENOME:ANNOTATION_BEDTOOLS_SORT' {
            ext.prefix = { "${meta.id}.sorted" }
            publishDir = [
                path: { "${params.outdir}/reference/${params.target_genome}/annotation" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }
    }
}

if (params.run_genome_prep && params.blacklist) {
    process {
        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:PREPARE_GENOME:BLACKLIST_AWK' {
            ext.command = "'{OFS = \"\\t\"} {print \$1, '0', \$2}'"
            ext.ext     = "bed"
            publishDir = [
                enabled: false
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:PREPARE_GENOME:BLACKLIST_BEDTOOLS_SORT' {
            publishDir = [
                enabled: false
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:PREPARE_GENOME:BLACKLIST_BEDTOOLS_INTERSECT' {
            publishDir = [
                enabled: false
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:PREPARE_GENOME:BLACKLIST_BEDTOOLS_COMPLEMENT' {
            publishDir = [
                path: { "${params.outdir}/reference/${params.target_genome}/" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }
    }
}

if (params.run_genome_prep && !params.gene_bed) {
    process {
        withName: '.*PREPARE_GENOME:GTF2BED' {
            publishDir = [
                path: { "${params.outdir}/reference/${params.target_genome}/annotation" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_reference
            ]
        }
    }
}

/*
========================================================================================
    PRE-ALIGNMENT
========================================================================================
*/

if(params.run_cat_fastq) {
    process {
        withName: 'CAT_FASTQ' {
            publishDir = [
                path: { "${params.outdir}/01_prealign/merged_fastq" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_merged_fastq
            ]
        }
    }
}

if(params.run_trim_galore_fastqc && !params.skip_fastqc) {
    process {
        withName: '.*:FASTQC_TRIMGALORE:FASTQC' {
            ext.args   = '--quiet'
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/01_prealign/pretrim_fastqc" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            ]
        }
    }
}

if(params.run_trim_galore_fastqc && !params.skip_trimming) {
    process {
        withName: '.*:FASTQC_TRIMGALORE:TRIMGALORE' {
            ext.args   = [
                '--fastqc',
                params.trim_nextseq > 0 ? "--nextseq ${params.trim_nextseq}" : ''
            ].join(' ').trim()
            publishDir = [
                [
                    path: { "${params.outdir}/1_individual_samples/01_prealign/trimgalore/fastqc" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.{html,zip}"
                ],
                [
                    path: { "${params.outdir}/1_individual_samples/01_prealign/trimgalore" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.fastq.gz",
                    enabled: params.save_trimmed
                ],
                [
                    path: { "${params.outdir}/1_individual_samples/01_prealign/trimgalore" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.txt"
                ]
            ]
        }
    }
}

/*
========================================================================================
    ALIGNMENT
========================================================================================
*/

if(params.run_alignment) {
    process {
        withName: '.*:ALIGN_BOWTIE2:BOWTIE2_TARGET_ALIGN' {
            ext.args   = { params.end_to_end ? '--end-to-end --very-sensitive --no-mixed --no-discordant --phred33 --minins 10 --maxins 700 ' : '--local --very-sensitive --no-mixed --no-discordant --phred33 --minins 10 --maxins 700 ' }
            publishDir = [
                [
                    path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}/log" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.log'
                ],
                [
                    path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.bam',
                    enabled: ( params.save_align_intermed || (!params.run_read_filter && !params.run_mark_dups && !params.run_remove_dups) )
                ],
                [
                    path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}/unmapped" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.fastq.gz',
                    enabled: params.save_unaligned
                ]
            ]
        }

        withName: '.*:ALIGN_BOWTIE2:BOWTIE2_SPIKEIN_ALIGN' {
            ext.args   = { params.end_to_end ? '--end-to-end --very-sensitive --no-overlap --no-mixed --no-discordant --phred33 --minins 10 --maxins 700' : '--local --very-sensitive --no-overlap --no-mixed --no-discordant --phred33 --minins 10 --maxins 700' }
            ext.prefix = { "${meta.id}.spikein" }
            publishDir = [
                [
                    path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.spikein_genome}/log" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.log'
                ],
                [
                    path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.spikein_genome}" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.bam',
                    enabled: params.save_spikein_aligned
                ],
                [
                    path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.spikein_genome}/unmapped" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.fastq.gz',
                    enabled: ( params.save_spikein_aligned && params.save_unaligned )
                ]
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:.*:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:.*' {
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.{stats,flagstat,idxstats}",
                enabled: false
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:.*:BAM_SORT_STATS_SAMTOOLS_SPIKEIN:BAM_STATS_SAMTOOLS:.*' {
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.spikein_genome}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.{stats,flagstat,idxstats}",
                enabled: params.save_spikein_aligned
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:.*:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
            ext.prefix = { "${meta.id}.target.sorted" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bam",
                enabled: ( params.save_align_intermed || (!params.run_read_filter && !params.run_mark_dups && !params.run_remove_dups) )
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:.*:BAM_SORT_STATS_SAMTOOLS_SPIKEIN:SAMTOOLS_SORT' {
            ext.prefix = { "${meta.id}.spikein.sorted" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.spikein_genome}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bam",
                enabled: params.save_spikein_aligned
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:.*:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
            ext.prefix = { "${meta.id}.target.sorted" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bai",
                enabled: ( params.save_align_intermed || (!params.run_read_filter && !params.run_mark_dups && !params.run_remove_dups) )
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:.*:BAM_SORT_STATS_SAMTOOLS_SPIKEIN:SAMTOOLS_INDEX' {
            ext.prefix = { "${meta.id}.spikein.sorted" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.spikein_genome}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bai",
                enabled: params.save_spikein_aligned
            ]
        }
    }
}

/*
========================================================================================
    READ-FILTERING
========================================================================================
*/

if(params.run_read_filter) {
    process {
        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:FILTER_READS:SAMTOOLS_VIEW' {
            ext.args = "-b -q ${params.minimum_alignment_q_score} -F 0x004 -F 0x0008 -f 0x001"
            if (params.mito_name == null && params.genome == null){
                ext.args2 = ''
            } else if (params.mito_name == null) {
                ext.args2 = { params.remove_mitochondrial_reads ? "-e 'rname != \"${params.genomes[params.genome]["mito_name"]}\"'" : '' }
            } else {
                ext.args2 = { params.remove_mitochondrial_reads ? "-e 'rname != \"${params.mito_name}\"'" : '' }
            }
            ext.prefix = { "${meta.id}.target.filtered" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bam",
                enabled: ( params.save_align_intermed || (!params.run_mark_dups && !params.run_remove_dups) )
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:FILTER_READS:SAMTOOLS_SORT' {
            ext.prefix = { "${meta.id}.target.filtered.sorted" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bam",
                enabled: ( params.save_align_intermed || (!params.run_mark_dups && !params.run_remove_dups) )
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:FILTER_READS:SAMTOOLS_INDEX' {
            ext.prefix = { "${meta.id}.target.filtered" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bai",
                enabled: ( params.save_align_intermed || (!params.run_mark_dups && !params.run_remove_dups) )
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:FILTER_READS:BAM_STATS_SAMTOOLS:.*' {
            ext.prefix = { "${meta.id}.target.filtered" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.{stats,flagstat,idxstats}",
                enabled: ( params.save_align_intermed || (!params.run_mark_dups && !params.run_remove_dups) )
            ]
        }
    }
}


/*
========================================================================================
    DUPLICATES
========================================================================================
*/

if(params.run_mark_dups) {
    process {
        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:MARK_DUPLICATES_PICARD:PICARD_MARKDUPLICATES' {
            ext.args = "--ASSUME_SORT_ORDER coordinate --REMOVE_DUPLICATES false --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp"
            ext.prefix = { "${meta.id}.target.markdup" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}/markdup" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.metrics.txt",
                enabled: params.run_mark_dups
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:MARK_DUPLICATES_PICARD:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
            ext.prefix = { "${meta.id}.target.markdup.sorted" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bam",
                enabled: params.run_mark_dups
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:MARK_DUPLICATES_PICARD:BAM_SORT_STATS_SAMTOOLS:.*' {
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.{bam,bai}",
                enabled: params.run_mark_dups
            ]
        }
    }
}

if(params.run_remove_dups) {
    process {
        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:DEDUPLICATE_PICARD:PICARD_MARKDUPLICATES' {
            ext.args = "--ASSUME_SORT_ORDER coordinate --REMOVE_DUPLICATES true --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp"
            ext.prefix = { "${meta.id}.target.dedup" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}/dedup" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bam",
                enabled: false
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:DEDUPLICATE_PICARD:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
            ext.prefix = { "${meta.id}.target.dedup.sorted" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}/dedup" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bam",
                enabled: false
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:DEDUPLICATE_PICARD:BAM_SORT_STATS_SAMTOOLS:.*' {
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/${params.aligner}/${params.target_genome}/dedup" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.{stats,flagstat,idxstats}",
                enabled: false
            ]
        }
    }
}

/*
========================================================================================
    ANNOTATE META WITH ALIGN AND DUP STATS
========================================================================================
*/

if (params.run_alignment) {
    process {
        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:EXTRACT_BT2_TARGET_META:AWK_SCRIPT' {
            ext.suffix = "_meta_bt2_target"
            publishDir = [
                enabled: false
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:EXTRACT_BT2_SPIKEIN_META:AWK_SCRIPT' {
            ext.suffix = "_meta_bt2_spikein"
            publishDir = [
                enabled: false
            ]
        }
    }
}

if (params.run_mark_dups) {
    process {
        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:EXTRACT_PICARD_DUP_META:AWK' {
            ext.suffix = "_meta_picard_dups"
            ext.command = "'/^[^#]/{print}'"
            ext.command2 = " > int1.txt && head -2 int1.txt > int2.txt && sed 's/\\t/,/g' int2.txt > int3.txt && sed 's/.*/\\L&/g' int3.txt "
            publishDir = [
                enabled: false
            ]
        }
    }
}

/*
========================================================================================
    SCALING/CONVERSION AND PEAK CALLING
========================================================================================
*/

if(params.run_alignment) {
    process {
        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:COMPUTE_GENOMECOVERAGE:BEDTOOLS_GENOMECOV_MARKDUP_UNNORM' {
            ext.args = params.extend_fragments ? '-bg -pc' : '-bg'
            ext.prefix = { "${meta.id}.markdup.unnormalized" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/03_genome_coverage/unnormalized_bedgraph/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.{bedGraph}",
                enabled: true

            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:COMPUTE_GENOMECOVERAGE:BEDTOOLS_GENOMECOV_DEDUP_UNNORM' {
            ext.args = params.extend_fragments ? '-bg -pc' : '-bg'
            ext.prefix = { "${meta.id}.dedup.unnormalized" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/03_genome_coverage/unnormalized_bedgraph/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.{bedGraph}",
                enabled: true

            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:COMPUTE_GENOMECOVERAGE:BEDTOOLS_GENOMECOV_MARKDUP_SPIKEIN' {
            ext.args = params.extend_fragments ? '-bg -pc' : '-bg'
            ext.prefix = { "${meta.id}.markdup.spikein_normalized" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/03_genome_coverage/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.{bedGraph}",
                enabled: false
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:COMPUTE_GENOMECOVERAGE:DEEPTOOLS_BAMCOVERAGE_MARKDUP' {
            ext.args   = [
                '--outFileFormat bigwig',
                '--skipNAs',
                "--binSize ${params.normalisation_binsize}",
                "--normalizeUsing CPM",
                params.extend_fragments ? '--extendReads' : '',
            ].join(' ').trim()
            ext.prefix = { "${meta.id}.markdup.CPM.bigWig" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/03_genome_coverage/normalized_bigwig" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bigWig",
                enabled: true
            ]
        }

        withName: 'NFCORE_CUTANDRUN:CUTANDRUN:COMPUTE_GENOMECOVERAGE:DEEPTOOLS_BAMCOVERAGE_DEDUP' {
            ext.args   = [
                '--outFileFormat bigwig',
                '--skipNAs',
                "--binSize ${params.normalisation_binsize}",
                "--normalizeUsing CPM",
                params.extend_fragments ? '--extendReads' : '',
            ].join(' ').trim()
            ext.prefix = { "${meta.id}.dedup.CPM.bigWig" }
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/03_genome_coverage/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bigWig",
                enabled: false
            ]
        }

    }
}



if(params.run_peak_calling ) {
    /*
    * SEACR peaks with individual IgG
    */
    process {
        withName: '.*:SEACR_CALLPEAK_IGG' {
            ext.args   = "norm ${params.seacr_stringent}"
            ext.prefix = { "${meta.id}.seacr_igg_peaks" }
            publishDir = [
                path: { "${params.outdir}/${params.seacr_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bed",
                enabled: true
            ]
        }


        withName: '.*:SEACR_CALLPEAK_NOIGG' {
            ext.args   = "non ${params.seacr_stringent}"
            ext.prefix = { "${meta.id}.seacr_noigg_peaks" }
            publishDir = [
                [
                    path: { "${params.outdir}/${params.seacr_dir}" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.bed",
                    enabled: true
                ],
                [
                    path: { "${params.outdir}/${params.seacr_comb_igg_dir}" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.bed",
                    enabled: true
                ],

            ]
        }

        withName: '.*:SEACR_BEDTOOLS_INTERSECT' {
            ext.args   = "-u"
            ext.prefix = { "${meta.id}.seacr_igg_peaks" }
            ext.suffix = "${params.seacr_stringent}.filtered.bed"
            publishDir = [
                path: { "${params.outdir}/${params.seacr_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bed",
                enabled: true
            ]

        }

    }

    /*
    * SEACR peaks with combined IgG
    */
    process {
        withName: '.*:UNION_BEDGRAPH_DEDUP' {
            ext.args   = ""
            ext.suffix = ".dedup.unnormalized"
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/03_genome_coverage/_combine_igg/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.unionbdg",
                enabled: false
            ]
        }

        withName: '.*:MERGE_UNION_BEDGRAPH_DEDUP' {
            ext.args   = ""
            ext.suffix = ".dedup.unnormalized"
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/03_genome_coverage/unnormalized_bedgraph/_combined_igg/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bedGraph",
                enabled: true
            ]
        }

        withName: '.*:SEACR_CALLPEAK_COMB_IGG' {
            ext.args   = "norm ${params.seacr_stringent}"
            ext.prefix = { "${meta.id}.seacr_igg_peaks" }
            publishDir = [
                path: { "${params.outdir}/${params.seacr_comb_igg_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bed",
                enabled: true
            ]
        }

        withName: '.*:SEACR_BEDTOOLS_INTERSECT_COMB_IGG' {
            ext.args   = "-u"
            ext.prefix = { "${meta.id}.seacr_igg_peaks" }
            ext.suffix = "${params.seacr_stringent}.filtered.bed"
            publishDir = [
                path: { "${params.outdir}/${params.seacr_comb_igg_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bed",
                enabled: true
            ]

        }
    }

    /*
    * MACS2 peaks with individual IgG
    */
    process {
        withName: '.*:MACS2_NARROW_IGG' {
            ext.args   = [
                "--keep-dup all ",
                params.macs2_pvalue ? "-p ${params.macs2_pvalue}" : "-q ${params.macs2_qvalue}",
                '--tempdir .'
            ].join(' ').trim()
            ext.prefix = { "${meta.id}.macs2_igg_narrow" }
            publishDir = [
                path: { "${params.outdir}/${params.macs2_narrow_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.{narrowPeak}",
                enabled: true
            ]
        }

        withName: '.*:MACS2_NARROW_NOIGG' {
            ext.args   = [
                "--keep-dup all ",
                params.macs2_pvalue ? "-p ${params.macs2_pvalue}" : "-q ${params.macs2_qvalue}",
                '--tempdir .'
            ].join(' ').trim()
            ext.prefix = { "${meta.id}.macs2_noigg_narrow" }
            publishDir = [
                [
                    path: { "${params.outdir}/${params.macs2_narrow_dir}" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.{narrowPeak}",
                    enabled: true
                ],
                [
                    path: { "${params.outdir}/${params.macs2_narrow_comb_igg_dir}" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.{narrowPeak}",
                    enabled: true
                ]
            ]
        }

        withName: '.*:MACS2_BROAD_IGG' {
            ext.args   = [
                "--keep-dup all ",
                params.macs2_pvalue ? "-p ${params.macs2_pvalue}" : "-q ${params.macs2_qvalue}",
                "--broad --broad-cutoff ${params.macs2_broad_cutoff}",
                '--tempdir .'
            ].join(' ').trim()
            ext.prefix = { "${meta.id}.macs2_igg_broad" }
            publishDir = [
                path: { "${params.outdir}/${params.macs2_broad_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.{broadPeak}",
                enabled: true
            ]
        }

        withName: '.*:MACS2_BROAD_NOIGG' {
            ext.args   = [
                "--keep-dup all --nomodel --nolambda",
                params.macs2_pvalue ? "-p ${params.macs2_pvalue}" : "-q ${params.macs2_qvalue}",
                "--broad --broad-cutoff ${params.macs2_broad_cutoff}",
                '--tempdir .'
            ].join(' ').trim()
            ext.prefix = { "${meta.id}.macs2_noigg_broad" }
            publishDir = [
                [
                    path: { "${params.outdir}/${params.macs2_broad_dir}" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.{broadPeak}",
                    enabled: true
                ],
                [
                    path: { "${params.outdir}/${params.macs2_broad_comb_igg_dir}" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.{broadPeak}",
                    enabled: true
                ]
            ]
        }

        withName: '.*:NARROW_BEDTOOLS_INTERSECT' {
            ext.args   = "-u"
            ext.prefix = { "${meta.id}.macs2_igg_narrow_peaks" }
            ext.suffix = "intersected.narrowPeak"
            publishDir = [
                path: { "${params.outdir}/${params.macs2_narrow_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.narrowPeak",
                enabled: false
            ]
        }

        withName: '.*:NARROW_FILTER' {
            ext.prefix = { "${meta.id}.macs2_igg_narrow_peaks" }
            ext.suffix = "narrowPeak"
            publishDir = [
                path: { "${params.outdir}/${params.macs2_narrow_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.filtered.*",
                optional: true,
                enabled: true
            ]
        }

        withName: '.*:BROAD_BEDTOOLS_INTERSECT' {
            ext.args   = "-u"
            ext.prefix = { "${meta.id}.macs2_noigg_broad_peaks" }
            ext.suffix = "intersected.broadPeak"
            publishDir = [
                path: { "${params.outdir}/${params.macs2_broad_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.broadPeak",
                enabled: false
            ]
        }


        withName: '.*:BROAD_FILTER' {
            ext.prefix = { "${meta.id}.macs2_noigg_broad_peaks" }
            ext.suffix = "broadPeak"
            publishDir = [
                path: { "${params.outdir}/${params.macs2_broad_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.filtered.*",
                optional: true,
                enabled: true
            ]
        }

    }

    /*
    * MACS2 peaks with combined IgG
    */
    process {
        withName: '.*:CALL_MACS2_PEAKS:MERGE_BAM' {
            ext.args   = ""
            ext.suffix = ".target.markdup.sorted"
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/02_alignment/bowtie2/${params.target_genome}/_combined_igg/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bam",
                enabled: true
            ]
        }

        withName: '.*:CALL_MACS2_PEAKS:BAM_COVERAGE' {
            ext.args   = [
                '--outFileFormat bigwig',
                '--skipNAs',
                "--binSize ${params.normalisation_binsize}",
                "--normalizeUsing CPM",
                params.extend_fragments ? '--extendReads' : '',
            ].join(' ').trim()
            ext.prefix = { "${id}.bigWig" }
            publishDir = [
                path: { "${params.outdir}/3_igv_and_plots_combined_igg/02_CPM_bigwig/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.bigWig",
                enabled: params.run_summary_plots
            ]
        }

        withName: '.*:MACS2_NARROW_COMB_IGG' {
            ext.args   = [
                "--keep-dup all ",
                params.macs2_pvalue ? "-p ${params.macs2_pvalue}" : "-q ${params.macs2_qvalue}",
                ''
            ].join(' ').trim()
            ext.prefix = { "${meta.id}.macs2_igg_narrow" }
            publishDir = [
                path: { "${params.outdir}/${params.macs2_narrow_comb_igg_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.{narrowPeak}",
                enabled: true
            ]
        }

        withName: '.*:NARROW_COMB_IGG_BEDTOOLS_INTERSECT' {
            ext.args   = "-u"
            ext.prefix = { "${meta.id}.macs2_igg_narrow_peaks" }
            ext.suffix = "intersected.narrowPeak"
            publishDir = [
                path: { "${params.outdir}/${params.macs2_narrow_comb_igg_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.narrowPeak",
                enabled: false
            ]
        }

        withName: '.*:NARROW_COMB_IGG_FILTER' {
            ext.prefix = { "${meta.id}.macs2_igg_narrow_peaks" }
            ext.suffix = "narrowPeak"
            publishDir = [
                path: { "${params.outdir}/${params.macs2_narrow_comb_igg_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.filtered.*",
                optional: true,
                enabled: true
            ]
        }

        withName: '.*:MACS2_BROAD_COMB_IGG' {
            ext.args   = [
                "--keep-dup all ",
                params.macs2_pvalue ? "-p ${params.macs2_pvalue}" : "-q ${params.macs2_qvalue}",
                "--broad --broad-cutoff ${params.macs2_broad_cutoff}"
            ].join(' ').trim()
            ext.prefix = { "${meta.id}.macs2_igg_broad" }
            publishDir = [
                path: { "${params.outdir}/${params.macs2_broad_comb_igg_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.{broadPeak}",
                enabled: true
            ]
        }

        withName: '.*:BROAD_COMB_IGG_BEDTOOLS_INTERSECT' {
            ext.args   = "-u"
            ext.prefix = { "${meta.id}.macs2_noigg_broad_peaks" }
            ext.suffix = "intersected.broadPeak"
            publishDir = [
                path: { "${params.outdir}/${params.macs2_broad_comb_igg_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.broadPeak",
                enabled: false
            ]
        }

        withName: '.*:BROAD_COMB_IGG_FILTER' {
            ext.prefix = { "${meta.id}.macs2_noigg_broad_peaks" }
            ext.suffix = "broadPeak"
            publishDir = [
                path: { "${params.outdir}/${params.macs2_broad_comb_igg_dir}" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.filtered.*",
                optional: true,
                enabled: true
            ]
        }

    }
}

if(params.run_peak_calling & params.workflow == 'process_controls') {
    /*
