                params.macs2_pvalue ? "-p ${params.macs2_pvalue}" : "-q ${params.macs2_qvalue}",
                "--broad --broad-cutoff ${params.macs2_broad_cutoff}"
            ].join(' ').trim()
            ext.prefix = { "${meta.id}.macs2_noigg_broad" }
            publishDir = [
                [
                    path: { "${params.outdir}/04_peak_calling/1_individual_samples/macs2_broad" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.{broadPeak}",
                    enabled: true
                ],
                [
                    path: { "${params.outdir}/04_peak_calling_combined_igg/1_individual_samples/macs2_broad" },
                    mode: "${params.publish_dir_mode}",
