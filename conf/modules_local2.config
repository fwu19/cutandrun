if(params.run_read_qc) {
    process {
        withName: '.*:MULTIQC' {
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/05_multiqc/" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: '.*:FRAGMENT_LENGTHS' {
            publishDir = [
                path: { "${params.outdir}/cached_data/fragment_lengths/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.fragment_lengths.txt',
                enabled: params.cache
            ]
        }

        withName: '.*:READ_METRICS' {
            publishDir = [
                path: { "${params.outdir}/cached_data/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*',
                enabled: params.cache
            ]
        }
    }
}

if(params.run_peak_qc) {
    // with individual IgG
    process{
        withName: '.*:QC_PEAKS:READS_IN_PEAK' {
            publishDir = [
                path: { "${params.outdir}/cached_data/individual_igg/reads_in_peak/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.reads_in_peak.csv',
                enabled: params.cache
            ]
        }

        withName: '.*:QC_PEAKS:ORIGINAL_PEAKS' {
            publishDir = [
                path: { "${params.outdir}/cached_data/individual_igg/original_peaks/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.csv',
                enabled: params.cache
            ]
        }

        withName: '.*:QC_PEAKS:ORIGINAL_PEAK_WIDTHS' {
            publishDir = [
                path: { "${params.outdir}/cached_data/individual_igg/original_peak_widths/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.csv',
                enabled: params.cache
            ]
        }

        withName: '.*:QC_PEAKS:REPLICATED_PEAKS' {
            publishDir = [
                [
                    path: { "${params.outdir}/cached_data/individual_igg/replicated_peaks/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.csv',
                    enabled: params.cache
                ],

                [
                    path: { "${params.outdir}/1_individual_samples/04_peak_calling/replicated_peaks" },
                    mode: "${params.publish_dir_mode}",
                    pattern: 'multiple_replicates/*.bed',
                    enabled: false,
                    optional: true
                ],

                [
                    path: { "${params.outdir}/1_individual_samples/04_peak_calling/replicated_peaks" },
                    mode: "${params.publish_dir_mode}",
                    pattern: 'single_replicate/*.bed',
                    enabled: false,
                    optional: true
                ]

            ]
        }

        withName: '.*:QC_PEAKS:CONSENSUS_PEAKS' {
            publishDir = [
                [
                    path: { "${params.outdir}/cached_data/individual_igg/consensus_peaks/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.csv',
                    enabled: params.cache
                ],

                [
                    path: { "${params.outdir}/2_consensus_peaks/00_peak_beds/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.bed'
                ]
            ]

        }

        withName: '.*:QC_PEAKS:ANNOTATE_CONSENSUS_PEAKS' {
            publishDir = [
                [
                    path: { "${params.outdir}/2_consensus_peaks/01_peak_annotations/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.annotation.txt'
                ],
                [
                    path: { "${params.outdir}/3_igv_and_plots/00_gene_reference/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.gtf',
                    saveAs: { filename -> "genes.gtf" }
                ]

            ]

        }

        withName: '.*:QC_PEAKS:RECALL_REFERENCE_PEAKS' {
            publishDir = [
                path: { "${params.outdir}/1_individual_samples/qc/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.csv',
                enabled: false
            ]
        }

    }

    // with combined IgG
    process{
        withName: '.*:QC_PEAKS:READS_IN_PEAK_COMB_IGG' {
            publishDir = [
                path: { "${params.outdir}/cached_data/combined_igg/reads_in_peak/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.reads_in_peak.csv',
                enabled: params.cache
            ]
        }

        withName: '.*:QC_PEAKS:ORIGINAL_PEAKS_COMB_IGG' {
            publishDir = [
                path: { "${params.outdir}/cached_data/combined_igg/original_peaks/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.csv',
                enabled: params.cache
            ]
        }

        withName: '.*:QC_PEAKS:ORIGINAL_PEAK_WIDTHS_COMB_IGG' {
            publishDir = [
                path: { "${params.outdir}/cached_data/combined_igg/original_peak_widths/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.csv',
                enabled: params.cache
            ]
        }

        withName: '.*:QC_PEAKS:REPLICATED_PEAKS_COMB_IGG' {
            publishDir = [
                [
                    path: { "${params.outdir}/cached_data/combined_igg/replicated_peaks" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.csv',
                    enabled: params.cache
                ],

                [
                    path: { "${params.outdir}/1_individual_samples/04_peak_calling_combined_igg/replicated_peaks/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: 'multiple_replicates/*.bed',
                    enabled: false,
                    optional: true
                ],

                [
                    path: { "${params.outdir}/1_individual_samples/04_peak_calling_combined_igg/replicated_peaks/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: 'single_replicate/*.bed',
                    enabled: false,
                    optional: true
                ]

            ]
        }

        withName: '.*:QC_PEAKS:CONSENSUS_PEAKS_COMB_IGG' {
            publishDir = [
                [
                    path: { "${params.outdir}/cached_data/combined_igg/consensus_peaks/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.csv',
                    enabled: params.cache
                ],

                [
                    path: { "${params.outdir}/2_consensus_peaks_combined_igg/00_peak_beds/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.bed',
                    enabled: true
                ]
            ]

        }

        withName: '.*:QC_PEAKS:ANNOTATE_CONSENSUS_PEAKS_COMB_IGG' {
            publishDir = [
                [
                    path: { "${params.outdir}/2_consensus_peaks_combined_igg/01_peak_annotations/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.annotation.txt'
                ],
                [
                    path: { "${params.outdir}/3_igv_and_plots_combined_igg/00_gene_reference/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.gtf',
                    saveAs: { filename -> "genes.gtf" }
                ]

            ]

        }

    }

    // with process controls
    process{
        withName: '.*:QC_PROCESS_CONTROLS:READS_IN_PEAK' {
            publishDir = [
                path: { "${params.outdir}/04_reporting/qc/reads_in_peak/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.reads_in_peak.csv',
                enabled: false
            ]
        }

        withName: '.*:QC_PROCESS_CONTROLS:ORIGINAL_PEAKS' {
            publishDir = [
                path: { "${params.outdir}/04_reporting/qc/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.csv',
                enabled: false
            ]
        }

        withName: '.*:QC_PROCESS_CONTROLS:ORIGINAL_PEAK_WIDTHS' {
            publishDir = [
                path: { "${params.outdir}/04_reporting/qc/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.csv',
                enabled: false
            ]
        }

        withName: '.*:QC_PROCESS_CONTROLS:RECALL_REFERENCE_PEAKS' {
            publishDir = [
                path: { "${params.outdir}/04_reporting/qc/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.csv',
                enabled: false
            ]
        }
    }
}


if ( params.run_differential_peaks ) {
    // with individual IgG
    process {
        withName: '.*:READS_IN_CONSENSUS_PEAKS' {
            publishDir = [
                path: { "${params.outdir}/2_consensus_peaks/02_differential_peaks/featureCounts" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.fragmentCounts.*',
                enabled: false
            ]
        }

        withName: '.*:COLLECT_COUNT_MATRIX' {
            publishDir =    [
                    path: { "${params.outdir}/cached_data/individual_igg/_read_counts_in_peak/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.raw_counts.txt",
                    optional: true,
                    enabled: false
                ]
        }

        withName: '.*:DIFFERENTIAL_PEAKS' {
            ext.args = ""
            publishDir = [
                [   path: { "${params.outdir}/2_consensus_peaks/02_differential_peaks/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*_peaks",
                    optional: true
                ],
                [   path: { "${params.outdir}/cached_data/individual_igg/differential_peaks/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.rds",
                    optional: true,
                    enabled: params.cache
                ]
            ]
        }
    }

    // with combined IgG
        process {
        withName: '.*:READS_IN_CONSENSUS_PEAKS_COMB_IGG' {
            publishDir = [
                path: { "${params.outdir}/2_consensus_peaks_combined_igg/02_differential_peaks/featureCounts/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.fragmentCounts.*',
                enabled: false
            ]
        }

        withName: '.*:COLLECT_COUNT_MATRIX_COMB_IGG' {
            publishDir = [
                path: { "${params.outdir}/cached_data/combined_igg/_read_counts_in_peak" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.raw_counts.txt",
                    optional: true,
                    enabled: false
            ]
        }
        withName: '.*:DIFFERENTIAL_PEAKS_COMB_IGG' {
            ext.args = ""
            publishDir = [
                [   path: { "${params.outdir}/2_consensus_peaks_combined_igg/02_differential_peaks/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*_peaks",
                    optional: true
                ],
                [   path: { "${params.outdir}/cached_data/combined_igg/differential_peaks" },
                    mode: "${params.publish_dir_mode}",
                    pattern: "*.rds",
                    optional: true,
                    enabled: params.cache
                ]
            ]
        }
    }
}


if(params.run_reporting) {
    process{
        withName: '.*:GENERATE_REPORT:MAKE_REPORT' {
            ext.suffix = ""
            publishDir = [
                [
                    path: { "${params.outdir}/cached_data/individual_igg/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.{rds,Rmd,rmd,html}',
                    enabled: params.cache
                ],
                [
                    path: { "${params.outdir}/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.html',
                    enabled: true
                ]
            ]
        }

        withName: '.*:GENERATE_REPORT:MAKE_REPORT_COMB_IGG' {
            ext.suffix = ".combined_IgG"
            publishDir = [
                [
                    path: { "${params.outdir}/cached_data/combined_igg/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.{rds,Rmd,rmd,html}',
                    enabled: params.cache
                ],
                [
                    path: { "${params.outdir}/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.html',
                    enabled: true
                ]
            ]
        }

        withName: '.*:GENERATE_REPORT_PROCESS_CONTROLS' {
            publishDir = [
                [
                    path: { "${params.outdir}/cached_data/process_controls" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.{rds,Rmd,rmd}',
                    enabled: params.cache
                ],
                [
                    path: { "${params.outdir}/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.html',
                    enabled: true
                ]
            ]
        }
    }

}

if(params.run_summary_plots ) {
    process{
        withName: '.*:GTF2GENES' {
            publishDir = [
                enabled: false
            ]
        }
    }

    // with individual IgG
    process{
        withName: '.*:SUMMARY_PLOTS:UPDATE_PEAKS' {
            publishDir = [
                path: { "${params.outdir}/3_igv_and_plots/01_peak_beds/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.bed',
                enabled: params.run_summary_plots
            ]
        }

        withName: '.*:SUMMARY_PLOTS:BIGWIG_AVERAGE' {
            publishDir = [
                path: { "${params.outdir}/3_igv_and_plots/02_CPM_bigwig/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.bigWig',
                enabled: params.run_summary_plots
            ]
        }

        withName: '.*:SUMMARY_PLOTS:BIGWIG_AVERAGE_IGG' {
            publishDir = [
                path: { "${params.outdir}/3_igv_and_plots/02_CPM_bigwig/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.bigWig',
                enabled: params.run_summary_plots
            ]
        }

        withName: '.*:SUMMARY_PLOTS:TORNADO_PLOTS' {
            ext.args = "ref_type=center ignore_strand=T axis_name=-1Kb,Center,+1Kb "
            publishDir = [
                [
                    path: { "${params.outdir}/3_igv_and_plots/03_plots/tornado" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.pdf'
                ],
                [
                    path: { "${params.outdir}/3_igv_and_plots/00_gene_reference/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.bed'
                ]
            ]
        }

    }

    // with combined IgG
    process{
        withName: '.*:SUMMARY_PLOTS:UPDATE_PEAKS_COMB_IGG' {
            publishDir = [
                path: { "${params.outdir}/3_igv_and_plots_combined_igg/01_peak_beds/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.bed'
            ]
        }

        withName: '.*:SUMMARY_PLOTS:BIGWIG_AVERAGE_COMB_IGG' {
            publishDir = [
                path: { "${params.outdir}/3_igv_and_plots_combined_igg/02_CPM_bigwig/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.bigWig'
            ]
        }

        withName: '.*:SUMMARY_PLOTS:TORNADO_PLOTS_COMB_IGG' {
            ext.args = "ref_type=center ignore_strand=T axis_name=-1Kb,Center,+1Kb "
            publishDir = [
                [
                    path: { "${params.outdir}/3_igv_and_plots_combined_igg/03_plots/tornado" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.pdf'
                ],
                [
                    path: { "${params.outdir}/3_igv_and_plots_combined_igg/00_gene_reference/" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.bed'
                ]
            ]
        }

    }

}

